# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Veri (ham veri büyük, kullanıcı kendisi indirir)
# Recursive — raw + cache git'lenmez. processed seçici şekilde.
data/raw/
data/cache/
data/processed/
# Klasör yapısı korunsun:
!data/raw/.gitkeep
!data/processed/.gitkeep
# CLOUD DASHBOARD İÇİN KÜÇÜK ARTIFACT'LAR — sync_artifacts.py ile commit edilir
!data/processed/backtests/
!data/processed/paper_trades.parquet
!data/processed/sentiment_daily.parquet
!data/processed/shortlist_*.parquet

# Modeller (artifact'lar repo'da değil — her ortam kendisi backtest ile üretir)
models/*.joblib
models/*.pkl
models/artifacts/

# Loglar
logs/
*.log

# Secrets
.env
*.key

# IDE
.vscode/
.idea/
*.swp
.DS_Store

