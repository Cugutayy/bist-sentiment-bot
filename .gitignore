# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Veri — raw + cache tamamen git dışı (büyük, hızlı değişken)
data/raw/
data/cache/
!data/raw/.gitkeep

# processed/ içinde SEÇİCİ ignore (parent ignore edilmez, böylece
# negation pattern'ları doğru çalışır)
data/processed/*
data/processed/sentiment_2*.parquet
!data/processed/.gitkeep
# CLOUD DASHBOARD için küçük artifact'lar — sync_artifacts.py ile commit
!data/processed/backtests/
!data/processed/paper_trades.parquet
!data/processed/paper_book.parquet
!data/processed/sentiment_daily.parquet
!data/processed/shortlist_*.parquet
!data/processed/trend_paper/
!data/processed/trend_paper/*.json

# Modeller (artifact'lar repo'da değil — her ortam kendisi backtest ile üretir)
models/*.joblib
models/*.pkl
models/artifacts/

# Loglar
logs/
*.log

# Secrets
.env
*.key

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Notebooks (eğer eklenirse)
.ipynb_checkpoints/
